<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignupController">
    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="430.0" spacing="18.0" styleClass="brand-panel">
            <padding><Insets bottom="48.0" left="48.0" right="48.0" top="48.0" /></padding>
            <Label styleClass="brand-kicker" text="REJOIGNEZ LA COMMUNAUT\u00C9" />
            <Label styleClass="brand-title" text="Cr\u00e9ez votre compte Agricole" wrapText="true" />
            <Label styleClass="brand-copy" text="G\u00e9rez vos fermes, vos animaux et vos stocks avec une solution moderne et intuitive." wrapText="true" />
        </VBox>
    </left>
    <center>
        <StackPane styleClass="login-surface">
            <VBox alignment="CENTER_LEFT" maxWidth="380.0" spacing="16.0" styleClass="login-form">
                <Label styleClass="form-title" text="Inscription" />
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Nom complet" />
                    <TextField fx:id="nameField" promptText="Ex: Ahmed Ben" />
                </VBox>
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Email" />
                    <TextField fx:id="emailField" promptText="email@exemple.com" />
                </VBox>
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Mot de passe" />
                    <PasswordField fx:id="passwordField" promptText="\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022" />
                </VBox>

                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="ID de la Ferme" />
                    <TextField fx:id="farmIdField" promptText="Ex: 1" />
                </VBox>
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Votre r\u00f4le" />
                    <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Choisir un r\u00f4le">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="ADMIN" />
                                <String fx:value="OUVRIER" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
                
                <Label fx:id="errorLabel" minHeight="22.0" styleClass="error-label" wrapText="true" />
                
                <Button fx:id="signupButton" defaultButton="true" maxWidth="Infinity" onAction="#handleSignup" styleClass="primary-button" text="S'inscrire maintenant" />
                
                <HBox alignment="CENTER" spacing="5.0">
                    <padding><Insets top="10.0" /></padding>
                    <Label text="D\u00e9j\u00e0 membre ?" />
                    <Label onMouseClicked="#goToLogin" styleClass="link-label" text="Se connecter" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
