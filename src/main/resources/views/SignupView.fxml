<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignupController">
    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="430.0" spacing="18.0" styleClass="brand-panel">
            <padding>
                <Insets bottom="48.0" left="48.0" right="48.0" top="48.0" />
            </padding>
            <Label styleClass="brand-kicker" text="Rejoignez-nous" />
            <Label styleClass="brand-title" text="Créer un compte" wrapText="true" />
            <Label styleClass="brand-copy" text="Inscrivez-vous pour obtenir un accès complet aux outils de gestion agricole et collaborer avec votre équipe." wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <HBox spacing="10.0" styleClass="brand-metrics">
                <Label text="SQL Server" />
                <Label text="JavaFX 21" />
            </HBox>
        </VBox>
    </left>
    <center>
        <StackPane styleClass="login-surface">
            <VBox alignment="CENTER_LEFT" maxWidth="360.0" spacing="16.0" styleClass="login-form">
                <Label styleClass="form-title" text="Inscription" />
                <Label styleClass="form-subtitle" text="Nouveau compte MANAGER" />
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Nom complet" />
                    <TextField fx:id="nameField" promptText="John Doe" styleClass="text-input" />
                </VBox>
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Email" />
                    <TextField fx:id="emailField" promptText="admin@example.com" styleClass="text-input" />
                </VBox>
                
                <VBox spacing="7.0">
                    <Label styleClass="field-label" text="Mot de passe" />
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-input" />
                </VBox>
                
                <Label fx:id="errorLabel" minHeight="22.0" styleClass="error-label" wrapText="true" />
                
                <Button fx:id="signupButton" defaultButton="true" maxWidth="Infinity" onAction="#handleSignup" styleClass="primary-button" text="S'inscrire" />
                
                <HBox alignment="CENTER" spacing="5.0">
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                    <Label text="Déjà un compte ?" textFill="#6b7280" />
                    <Label onMouseClicked="#goToLogin" styleClass="link-label" text="Se connecter" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
