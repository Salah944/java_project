<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" stylesheets="@../css/crud.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.OuvrierViewController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="header">
            <Button onAction="#goBack" styleClass="back-button" text="← Dashboard" />
            <Label styleClass="title-label" text="Gestion des Ouvriers" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#refresh" styleClass="back-button" text="Actualiser" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="ouvrierTable" styleClass="table-view">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Nom" />
                <TableColumn fx:id="emailColumn" prefWidth="250.0" text="Email" />
                <TableColumn fx:id="farmIdColumn" prefWidth="120.0" text="ID Ferme" />
                <TableColumn fx:id="salaireColumn" prefWidth="150.0" text="Salaire (€)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <right>
        <VBox prefWidth="350.0" spacing="15.0" styleClass="form-pane">
            <Label styleClass="form-title" text="Détails Ouvrier" />
            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Nom" />
                <TextField fx:id="nameField" promptText="Nom de l'ouvrier" styleClass="text-input" />
            </VBox>
            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Email" />
                <TextField fx:id="emailField" promptText="email@domaine.com" styleClass="text-input" />
            </VBox>
            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Mot de passe (si création ou modif)" />
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-input" />
            </VBox>
            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Salaire" />
                <TextField fx:id="salaireField" promptText="ex: 1500.00" styleClass="text-input" />
            </VBox>
            <VBox spacing="8.0">
                <Label styleClass="field-label" text="ID Ferme" />
                <TextField fx:id="farmIdField" promptText="ID de la ferme assignée" styleClass="text-input" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="10.0">
                <Button maxWidth="Infinity" onAction="#addOuvrier" styleClass="action-button, add-button" text="Ajouter Ouvrier" />
                <Button maxWidth="Infinity" onAction="#updateOuvrier" styleClass="action-button, update-button" text="Mettre à jour" />
                <Button maxWidth="Infinity" onAction="#deleteOuvrier" styleClass="action-button, delete-button" text="Supprimer" />
                <Button maxWidth="Infinity" onAction="#clearForm" styleClass="action-button" text="Vider le formulaire" />
            </VBox>
        </VBox>
    </right>
</BorderPane>
